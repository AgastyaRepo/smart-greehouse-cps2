# ─────────────────────────────────────────────
# Smart Greenhouse Dashboard V2 - Environment Variables
# ─────────────────────────────────────────────

# Server Port
PORT=3000

# MQTT Broker (gunakan mqtt://localhost:1883 untuk lokal atau mqtt://broker.emqx.io:1883)
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASS=

# Opsional: MQTT over WebSocket URL (untuk fallback direct client jika dibutuhkan)
MQTT_WS_URL=ws://localhost:9001

# Database File SQLite
DB_FILE=greenhouse.db

# Threshold Histeresis Fisik (sesuai SPEC.md & firmware)
FAN_ON=35
FAN_OFF=28
PUMP_ON=30
PUMP_OFF=60
